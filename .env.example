# ============================================================
# 声坊 Voice Atelier —— 环境变量模板
# 用法：复制为 .env，按需修改。.env 不提交版本库，密钥只在此处保存。
# 所有变量也可直接通过系统环境变量注入（优先级高于 .env）。
# ============================================================

# ---------- 上游语音服务（密钥只保存在这里，服务端读取，前端永不接触）----------
# ⚠️ 安全提示：请勿把密钥写入前端代码、提交到仓库或分享截图；一旦外泄立即轮换。
SPEECH_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SPEECH_API_BASE_URL=https://api.xiaomimimo.com/v1

# 上游协议要求的模型 ID（服务端读取；前端通过 /api/tts/options 动态获取，不写死）
TTS_MODEL=mimo-v2.5-tts
TTS_MODEL_DESIGN=mimo-v2.5-tts-voicedesign
TTS_MODEL_CLONE=mimo-v2.5-tts-voiceclone
ASR_MODEL=mimo-v2.5-asr

# 默认预置音色 ID 与预置音色列表（JSON 数组，单行）
TTS_DEFAULT_VOICE=mimo_default
TTS_PRESET_VOICES=[{"id":"mimo_default","name":"默认音色","desc":"自然均衡，通用播报"},{"id":"冰糖","name":"冰糖","desc":"清亮甜美，少女感"},{"id":"茉莉","name":"茉莉","desc":"温柔知性，适合旁白"},{"id":"苏打","name":"苏打","desc":"活泼轻快，带气泡感"},{"id":"白桦","name":"白桦","desc":"沉稳清冽，男声"},{"id":"Mia","name":"Mia","desc":"英文女声，自然口语"},{"id":"Chloe","name":"Chloe","desc":"英文女声，知性冷静"},{"id":"Milo","name":"Milo","desc":"英文男声，年轻活力"},{"id":"Dean","name":"Dean","desc":"英文男声，低沉稳重"}]

# 上游请求超时（秒）与失败重试次数
SPEECH_TIMEOUT=120
SPEECH_MAX_RETRIES=2

# 未配置密钥时是否允许以「模拟模式」启动（返回本地生成的占位音频/文本）
# 生产环境请设为 false
MOCK_MODE=true

# ---------- 应用安全（生产环境务必修改）----------
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# ---------- 存储 ----------
DATABASE_URL=sqlite:///./data/app.db
AUDIO_DIR=./data/audio
UPLOAD_DIR=./data/uploads

# 单次上传音频上限（MB）。上游要求 base64 后 ≤ 10MB，base64 膨胀约 1.33 倍，故默认 7MB
MAX_UPLOAD_MB=7
# 单次合成文本最大字符数
MAX_TEXT_LENGTH=2000

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ---------- 微信扫码登录（可选，留空即自动关闭）----------
# 未配置 WECHAT_APP_ID / WECHAT_APP_SECRET 时，微信登录入口自动隐藏，
# 且 /api/auth/wechat/* 返回 404，不影响用户名密码登录。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=http://127.0.0.1:8000/api/auth/wechat/callback
