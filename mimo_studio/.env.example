# 复制为 .env 后填写。也可以直接在系统环境变量里设置，或启动后在后台「系统配置」里填。

# ===== MiMo 官方 API =====
# 替换成你自己的 API Key（后台填写会覆盖这里的值）
MIMO_API_KEY=
MIMO_API_BASE=https://api.xiaomimimo.com/v1
TTS_MODEL=mimo-v2.5-tts
CLONE_MODEL=mimo-v2.5-tts-voiceclone

# ===== 服务 =====
HOST=127.0.0.1
PORT=8100

# ===== 安全 =====
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
# 不填则每次启动随机生成（重启后所有登录态失效）
SECRET_KEY=
SESSION_MAX_AGE=604800
# 部署到 https 时设为 1
COOKIE_SECURE=0

# ===== 默认管理员（仅首次启动创建）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ===== 业务默认值 =====
DEFAULT_QUOTA_CHARS=20000
MAX_TEXT_LEN=3000
CHUNK_MAX_CHARS=280
API_TIMEOUT=120
API_MAX_RETRIES=3
WORKER_THREADS=2
